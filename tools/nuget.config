<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Keep repository builds independent from a locked or damaged user NuGet.Config. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
